# ── EDU-ORB environment template ────────────────────────────────
# Copy to .env.local and fill in at least ONE AI provider key.
# .env.local is gitignored — never commit real keys.

# AI providers (fallback order: Groq → OpenRouter → Gemini → GitHub Models)
# At least one is required for chat / lesson / quiz features.

# Groq — fast inference (console.groq.com)
GROQ_API_KEY=

# OpenRouter — broad model access (openrouter.ai)
OPENROUTER_API_KEY=

# Google Gemini — free tier at aistudio.google.com
GOOGLE_API_KEY=

# GitHub Models — personal access token with "models:read" scope
GITHUB_TOKEN=

# ElevenLabs — optional, enables natural TTS voices (elevenlabs.io)
ELEVENLABS_API_KEY=